  m_TableData:
  - m_Id: 25563185152
    m_Localized: wake up
    m_Metadata:
      m_Items: []
  - m_Id: 3720468185088
    m_Localized: Finally awake huh ? Come to give me an hand over here, can't see
      anything due to this damn rain !
    m_Metadata:
      m_Items: []
  - m_Id: 5725773316096
    m_Localized: What are you waiting for ?! Don't know how to walk ?
    m_Metadata:
      m_Items: []
  - m_Id: 6254628913152
    m_Localized: Took you long !
    m_Metadata:
      m_Items: []
  - m_Id: 6916519444480
    m_Localized: Great, you see you can do things sometimes !
    m_Metadata:
      m_Items: []
  - m_Id: 7709016408064
    m_Localized: Ah dammit ! What are you doing ?! You'll see when it'll be deduced
      of your salary to cover your mess !
    m_Metadata:
      m_Items: []
  - m_Id: 10819503865856
    m_Localized: If you're not planning on watching all day, get the hammer and go
      at least repair what you damaged !
    m_Metadata:
      m_Items: []
  - m_Id: 11640605982720
    m_Localized: Huh... It'll be fine for now... but you'll have to learn that actions
      have consequences !
    m_Metadata:
      m_Items: []
  - m_Id: 13538285273088
    m_Localized: 04.1 en
    m_Metadata:
      m_Items: []
  - m_Id: 15080849620992
    m_Localized: 04.2 en
    m_Metadata:
      m_Items: []
  - m_Id: 15124222918656
    m_Localized: 04.3 en
    m_Metadata:
      m_Items: []
  - m_Id: 15182867677184
    m_Localized: 05 en
    m_Metadata:
      m_Items: []
  - m_Id: 15685840224256
    m_Localized: 06 en
    m_Metadata:
      m_Items: []
  - m_Id: 60398609842176
    m_Localized: Pick up the binnoculars on the deck !
    m_Metadata:
      m_Items: []
  - m_Id: 66874699104256
    m_Localized: Now use them and tell me where should I go !
    m_Metadata:
      m_Items: []
  - m_Id: 82534829342720
    m_Localized: And now which way ?
    m_Metadata:
      m_Items: []
  - m_Id: 83084140560384
    m_Localized: Are you sure you can even see ?! Where do I go next ?
    m_Metadata:
      m_Items: []
  - m_Id: 360781920026624
    m_Localized: To the left !
    m_Metadata:
      m_Items: []
  - m_Id: 360785103503360
    m_Localized: In the middle !
    m_Metadata:
      m_Items: []
  - m_Id: 360787410370560
    m_Localized: To the right !
    m_Metadata:
      m_Items: []
  - m_Id: 362296827133952
    m_Localized: Quick where do I go ?
    m_Metadata:
      m_Items: []
  - m_Id: 371392208912384
    m_Localized: Where finally out of this mess made by you...
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
