  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: TutorialTable_en
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: en
  m_SharedData: {fileID: 11400000, guid: 2429ee7206ff2564db7cb1d2a864cc4a, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 25563185152
    m_Localized: wake up
    m_Metadata:
      m_Items: []
  - m_Id: 3720468185088
    m_Localized: Finally awake huh ? Come to give me an hand over here, can't see
      anything due to this damn rain !
    m_Metadata:
      m_Items: []
  - m_Id: 5725773316096
    m_Localized: What are you waiting for ?! Don't know how to walk ?
    m_Metadata:
      m_Items: []
  - m_Id: 6254628913152
    m_Localized: Took you long !
    m_Metadata:
      m_Items: []
  - m_Id: 6916519444480
    m_Localized: Great, you see you can do things sometimes !
    m_Metadata:
      m_Items: []
  - m_Id: 7709016408064
    m_Localized: Ah dammit ! What are you doing ?! You'll see when it'll be deduced
      of your salary to cover your mess !
    m_Metadata:
      m_Items: []
  - m_Id: 10819503865856
    m_Localized: If you're not planning on watching all day, get the hammer and go
      at least repair what you damaged !
    m_Metadata:
      m_Items: []
  - m_Id: 11640605982720
    m_Localized: Huh... It'll be fine for now... but you'll have to learn that actions
      have consequences !
    m_Metadata:
      m_Items: []
  - m_Id: 13538285273088
    m_Localized: 04.1 en
    m_Metadata:
      m_Items: []
  - m_Id: 15080849620992
    m_Localized: 04.2 en
    m_Metadata:
      m_Items: []
  - m_Id: 15124222918656
    m_Localized: 04.3 en
    m_Metadata:
      m_Items: []
  - m_Id: 15182867677184
    m_Localized: Any questions ?
    m_Metadata:
      m_Items: []
  - m_Id: 1814154498228224
    m_Localized: Question 1 en
    m_Metadata:
      m_Items: []
  - m_Id: 60398609842176
    m_Localized: Pick up the binnoculars on the deck !
    m_Metadata:
      m_Items: []
  - m_Id: 66874699104256
    m_Localized: Now use them and tell me where should I go !
    m_Metadata:
      m_Items: []
  - m_Id: 82534829342720
    m_Localized: And now which way ?
    m_Metadata:
      m_Items: []
  - m_Id: 83084140560384
    m_Localized: Are you sure you can even see ?! Where do I go next ?
    m_Metadata:
      m_Items: []
  - m_Id: 360781920026624
    m_Localized: To the left !
    m_Metadata:
      m_Items: []
  - m_Id: 360785103503360
    m_Localized: In the middle !
    m_Metadata:
      m_Items: []
  - m_Id: 360787410370560
    m_Localized: To the right !
    m_Metadata:
      m_Items: []
  - m_Id: 362296827133952
    m_Localized: Quick where do I go ?
    m_Metadata:
      m_Items: []
  - m_Id: 371392208912384
    m_Localized: Where finally out of this mess made by you...
    m_Metadata:
      m_Items: []
  - m_Id: 1814633038954496
    m_Localized: Nothing in mind.
    m_Metadata:
      m_Items: []
  - m_Id: 1814514084298752
    m_Localized: Question 2 en
    m_Metadata:
      m_Items: []
  - m_Id: 1814603854987264
    m_Localized: Question 4 en
    m_Metadata:
      m_Items: []
  - m_Id: 1814559894487040
    m_Localized: Question 3 en
    m_Metadata:
      m_Items: []
  - m_Id: 1815735243325440
    m_Localized: Question 1 en
    m_Metadata:
      m_Items: []
  - m_Id: 1815738758152192
    m_Localized: Question 2 en
    m_Metadata:
      m_Items: []
  - m_Id: 1815740666560512
    m_Localized: Question 3 en
    m_Metadata:
      m_Items: []
  - m_Id: 1815742633689088
    m_Localized: I'll warn you, don't take me for an idiot and make myself repeat.
    m_Metadata:
      m_Items: []
  - m_Id: 1817263458959360
    m_Localized: Something else ?
    m_Metadata:
      m_Items: []
  - m_Id: 1881416504655872
    m_Localized: Anyway, with this you'll be able to do your job.
    m_Metadata:
      m_Items: []
  - m_Id: 1896456494465024
    m_Localized: I've warned you, you'll ask questions another time.
    m_Metadata:
      m_Items: []
  - m_Id: 2257789899456512
    m_Localized: Where arriving soon, get ready to get out.
    m_Metadata:
      m_Items: []
  - m_Id: 2258192019963904
    m_Localized: Where here, now go quickly.
    m_Metadata:
      m_Items: []
  - m_Id: 2259011645685760
    m_Localized: Hope you'll last at least a day.
    m_Metadata:
      m_Items: []
  - m_Id: 3250625566425088
    m_Localized: Now that you are on this island, you'll need to go to the Main Facility,
      it's located after the forest, don't worry nothing will happen.
    m_Metadata:
      m_Items: []
  - m_Id: 3250629844615168
    m_Localized: Great, now you'll need to find a way inside, try looking around.
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
