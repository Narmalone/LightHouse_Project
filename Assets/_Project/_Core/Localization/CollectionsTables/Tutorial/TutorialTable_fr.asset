  m_TableData:
  - m_Id: 25563185152
    m_Localized: se lever
    m_Metadata:
      m_Items: []
  - m_Id: 3720468185088
    m_Localized: "Enfin r\xE9veill\xE9 hein ? Viens me donner un coup de main, je
      ne vois rien \xE0 cause de cette stupide pluie !"
    m_Metadata:
      m_Items: []
  - m_Id: 5725773316096
    m_Localized: Qu'est-ce que t'attends ?! Tu ne sais pas marcher ?
    m_Metadata:
      m_Items: []
  - m_Id: 6254628913152
    m_Localized: T'en as pris du temps !
    m_Metadata:
      m_Items: []
  - m_Id: 6916519444480
    m_Localized: Parfait, tu vois tu peux faire des choses de temps en temps !
    m_Metadata:
      m_Items: []
  - m_Id: 7709016408064
    m_Localized: "Ah bordel ! Qu'est ce que tu fais encore ?! Tu verra \xE7a r\xE9duit
      de ton salaire pour payer ton erreur !"
    m_Metadata:
      m_Items: []
  - m_Id: 10819503865856
    m_Localized: "Si tu ne compte pas rester plant\xE9 l\xE0, prend ce marteau et
      va au moins r\xE9parer ce que t'as cass\xE9 !"
    m_Metadata:
      m_Items: []
  - m_Id: 11640605982720
    m_Localized: "Ah... \xC7a ira pour le moment... mais tu vas devoir apprendre
      que tes actions ont des cons\xE9quences !"
    m_Metadata:
      m_Items: []
  - m_Id: 13538285273088
    m_Localized: 04.1 fr
    m_Metadata:
      m_Items: []
  - m_Id: 15080849620992
    m_Localized: 04.3 fr
    m_Metadata:
      m_Items: []
  - m_Id: 15124222918656
    m_Localized: 04.3 fr
    m_Metadata:
      m_Items: []
  - m_Id: 15182867677184
    m_Localized: Des questions ?
    m_Metadata:
      m_Items: []
  - m_Id: 1814154498228224
    m_Localized: Question 1 fr
    m_Metadata:
      m_Items: []
  - m_Id: 60398609842176
    m_Localized: Prend les jumelles sur le pont !
    m_Metadata:
      m_Items: []
  - m_Id: 66874699104256
    m_Localized: Maintenant utilise les et dis moi ou je dois aller !
    m_Metadata:
      m_Items: []
  - m_Id: 83084140560384
    m_Localized: "T'es s\xFBr d'\xEAtre capable de voir ?! Je vais ou ensuite ?"
    m_Metadata:
      m_Items: []
  - m_Id: 82534829342720
    m_Localized: Et maintenant quelle direction ?
    m_Metadata:
      m_Items: []
  - m_Id: 360781920026624
    m_Localized: A gauche !
    m_Metadata:
      m_Items: []
  - m_Id: 360785103503360
    m_Localized: Au centre !
    m_Metadata:
      m_Items: []
  - m_Id: 360787410370560
    m_Localized: A droite !
    m_Metadata:
      m_Items: []
  - m_Id: 362296827133952
    m_Localized: Vite je vais ou ?
    m_Metadata:
      m_Items: []
  - m_Id: 371392208912384
    m_Localized: On est enfin sortie de ton bordel...
    m_Metadata:
      m_Items: []
  - m_Id: 1814633038954496
    m_Localized: "Aucune en t\xEAte."
    m_Metadata:
      m_Items: []
  - m_Id: 1814514084298752
    m_Localized: Question 2 fr
    m_Metadata:
      m_Items: []
  - m_Id: 1814559894487040
    m_Localized: Question 3 fr
    m_Metadata:
      m_Items: []
  - m_Id: 1814603854987264
    m_Localized: Question 4 fr
    m_Metadata:
      m_Items: []
  - m_Id: 1815735243325440
    m_Localized: Question 1 fr
    m_Metadata:
      m_Items: []
  - m_Id: 1815738758152192
    m_Localized: Question 2 fr
    m_Metadata:
      m_Items: []
  - m_Id: 1815740666560512
    m_Localized: Question 3 fr
    m_Metadata:
      m_Items: []
  - m_Id: 1815742633689088
    m_Localized: "Je te pr\xE9viens, ne me prend pas pour un idiot et me faire r\xE9p\xE9ter."
    m_Metadata:
      m_Items: []
  - m_Id: 1817263458959360
    m_Localized: Quelque chose d'autre ?
    m_Metadata:
      m_Items: []
  - m_Id: 1881416504655872
    m_Localized: "M'enfin, avec \xE7a tu sera capable de faire ton travail."
    m_Metadata:
      m_Items: []
  - m_Id: 1896456494465024
    m_Localized: "Je t'avais pr\xE9venu, tu posera des questions une prochaine fois."
    m_Metadata:
      m_Items: []
  - m_Id: 2257789899456512
    m_Localized: "On arrive bient\xF4t, soit pr\xEAt \xE0 partir."
    m_Metadata:
      m_Items: []
  - m_Id: 2258192019963904
    m_Localized: On y est, maintenant vas-y rapidement.
    m_Metadata:
      m_Items: []
  - m_Id: 2259011645685760
    m_Localized: "J'esp\xE8re que tu tiendra au moins un jour."
    m_Metadata:
      m_Items: []
  - m_Id: 3250625566425088
    m_Localized: "Maintenant que tu es sur cette ile, tu va devoir aller au B\xE2timent
      Principal, il est apr\xE8s la f\xF4ret, ne t'inqui\xE8te pas il ne t'arrivera
      rien."
    m_Metadata:
      m_Items: []
  - m_Id: 3250629844615168
    m_Localized: Parfait, maintenant tu dois trouver un moyen de rentrer, essaye
      de regarder autour.
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
