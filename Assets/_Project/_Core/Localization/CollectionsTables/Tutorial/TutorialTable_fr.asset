  m_TableData:
  - m_Id: 25563185152
    m_Localized: se lever
    m_Metadata:
      m_Items: []
  - m_Id: 3720468185088
    m_Localized: "Enfin r\xE9veill\xE9 hein ? Viens me donner un coup de main, je
      ne vois rien \xE0 cause de cette stupide pluie !"
    m_Metadata:
      m_Items: []
  - m_Id: 5725773316096
    m_Localized: Qu'est-ce que t'attends ?! Tu ne sais pas marcher ?
    m_Metadata:
      m_Items: []
  - m_Id: 6254628913152
    m_Localized: T'en as pris du temps !
    m_Metadata:
      m_Items: []
  - m_Id: 6916519444480
    m_Localized: Parfait, tu vois tu peux faire des choses de temps en temps !
    m_Metadata:
      m_Items: []
  - m_Id: 7709016408064
    m_Localized: "Ah bordel ! Qu'est ce que tu fais encore ?! Tu verra \xE7a r\xE9duit
      de ton salaire pour payer ton erreur !"
    m_Metadata:
      m_Items: []
  - m_Id: 10819503865856
    m_Localized: "Tu compte rester plant\xE9 l\xE0 encore longtemps ? Prend \xE7a
      et va au moins r\xE9parer ce que t'as cass\xE9 !"
    m_Metadata:
      m_Items: []
  - m_Id: 11640605982720
    m_Localized: "\xC7a ira pour le moment... mais tu vas devoir apprendre que tes
      actions ont des cons\xE9quences !"
    m_Metadata:
      m_Items: []
  - m_Id: 13538285273088
    m_Localized: 04.1 fr
    m_Metadata:
      m_Items: []
  - m_Id: 15080849620992
    m_Localized: 04.3 fr
    m_Metadata:
      m_Items: []
  - m_Id: 15124222918656
    m_Localized: 04.3 fr
    m_Metadata:
      m_Items: []
  - m_Id: 15182867677184
    m_Localized: 05 fr
    m_Metadata:
      m_Items: []
  - m_Id: 15685840224256
    m_Localized: 06 fr
    m_Metadata:
      m_Items: []
  - m_Id: 60398609842176
    m_Localized: Prend les jumelles sur le pont !
    m_Metadata:
      m_Items: []
  - m_Id: 66874699104256
    m_Localized: Maintenant utilise les et dis moi ou je dois aller !
    m_Metadata:
      m_Items: []
  - m_Id: 83084140560384
    m_Localized: "T'es s\xFBr d'\xEAtre capable de voir ?! Je vais ou ensuite ?"
    m_Metadata:
      m_Items: []
  - m_Id: 82534829342720
    m_Localized: Et maintenant quelle direction ?
    m_Metadata:
      m_Items: []
